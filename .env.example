DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/xml_feeds
TEMPORAL_HOST=localhost:7233
LOG_LEVEL=INFO

# Performance tuning
# MAX_ARTICLES=10          # Max articles to process per feed (default: 10)
# DB_POOL_SIZE=30          # SQLAlchemy connection pool size (default: 30)
# DB_MAX_OVERFLOW=60       # SQLAlchemy pool max overflow (default: 60)
# WORKER_COUNT=1           # Number of Temporal worker replicas (via docker compose scale)
